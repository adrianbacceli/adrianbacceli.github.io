---
import '../index.css';
import type { Locale, SiteContent } from '../i18n/content';
import { localePath, locales } from '../i18n/content';

interface Props { locale: Locale; content: SiteContent }
const { locale, content } = Astro.props;
const base = 'https://adrianbacceli.com';
const canonical = new URL(localePath(locale), base).toString();
const image = new URL('/og/profile-420x420.jpg', base).toString();
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person',
  name: 'Adrián Alberto Bacceli', alternateName: 'Adrian Bacceli', url: canonical, image,
  jobTitle: 'Advisor, Cybersecurity Engineering & Operations',
  worksFor: { '@type': 'Organization', name: 'Dell Technologies' },
  address: { '@type': 'PostalAddress', addressLocality: 'Panama City', addressCountry: 'PA' },
  email: 'mailto:contactme@adrianbacceli.com', telephone: '+507 6512-5606',
  knowsAbout: ['Vulnerability Management', 'Application Security', 'DAST', 'Cybersecurity Engineering', 'DevSecOps'],
  sameAs: ['https://www.linkedin.com/in/adrian-bacceli/', 'https://github.com/adrianbacceli', 'https://www.credly.com/users/adrian-bacceli/badges'],
};
---
<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="9DB4FEC4345FB9D6EDA758768A07A8A2" />
    <script is:inline>
      document.documentElement.classList.toggle('dark', localStorage.theme === 'dark' || (!('theme' in localStorage) && matchMedia('(prefers-color-scheme: dark)').matches));
    </script>
    <link rel="icon" href="/icons/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <meta name="theme-color" content="#f6f2e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111722" media="(prefers-color-scheme: dark)" />
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <meta name="author" content="Adrián Alberto Bacceli" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {locales.map((item) => <link rel="alternate" hreflang={item} href={new URL(localePath(item), base).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={`${base}/`} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Adrián Alberto Bacceli" />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="420" />
    <meta property="og:image:height" content="420" />
    <meta property="og:locale" content={content.meta.ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={content.meta.title} />
    <meta name="twitter:description" content={content.meta.description} />
    <meta name="twitter:image" content={image} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
