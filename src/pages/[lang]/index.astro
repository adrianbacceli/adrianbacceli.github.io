---
import PortfolioPage from '../../components/PortfolioPage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { content, type Locale } from '../../i18n/content';

export function getStaticPaths() {
  return ['es', 'it'].map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
---
<SiteLayout locale={locale} content={content[locale]}>
  <PortfolioPage locale={locale} content={content[locale]} />
</SiteLayout>
